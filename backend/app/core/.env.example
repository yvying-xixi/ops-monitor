# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=ops_monitor

# Redis
REDIS_URL="redis://:change-me@127.0.0.1:6379/0"

# JWT
JWT_SECRET_KEY=generate-a-long-random-secret
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=["*"]

# 种子数据
SEED_INIT_DATA=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123456

# 操作审计
OPERATION_LOG_ENABLED=true

# 数据保留
METRIC_RETENTION_DAYS=7
METRIC_AGG_RETENTION_DAYS=180
TASK_RETENTION_DAYS=30

# 日志与指标
LOG_LEVEL=INFO
METRICS_ENABLED=true
METRICS_TOKEN=

# 链路追踪（OpenTelemetry，默认关闭）
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ops-monitor-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# Agent 请求签名（Ed25519）
AGENT_REQUIRE_SIGNATURE=false
AGENT_SIGNATURE_MAX_SKEW=300

# 调度协调（多 worker / 多实例下每轮只执行一次）
SCHEDULER_LOCK_ENABLED=true
SCHEDULER_LOCK_TTL_SECONDS=600
