# ============================================================
# ops-monitor 平台配置模板
# 用法：
#   cp deploy/config.yml.tmpl deploy/config.yml
#   编辑本文件（至少修改 hostname）
#   ./deploy/install.sh            # 首次安装
#   ./deploy/reconfigure.sh        # 修改配置后重新渲染并重建
# 说明：
#   - 空字符串的密码/密钥会由 prepare 自动生成并回写本文件
#   - 本文件为唯一配置源，deploy/.env 为自动生成的渲染产物（请勿手改）
# ============================================================

# 平台对外访问地址（IP 或域名）。用于访问提示与 CORS
hostname: "127.0.0.1"

http:
  port: 80

# HTTPS（默认关闭）。启用后需将证书放入 deploy/nginx/certs 并填写路径
https:
  enabled: false
  port: 443
  certificate: ""          # 如 deploy/nginx/certs/fullchain.pem
  private_key: ""          # 如 deploy/nginx/certs/privkey.pem

# 业务数据库
database:
  name: ops_monitor
  password: ""             # 留空自动生成

# 缓存
redis:
  password: ""             # 留空自动生成

# 认证
jwt:
  secret_key: ""           # 留空自动生成
  expire_minutes: 120

# 初始管理员（仅首次初始化 seed 时生效）
admin:
  username: admin
  password: ""             # 留空自动生成

# 启动时初始化种子数据（角色/默认告警规则/管理员）
seed:
  init: true

# 监控指标保留天数
metrics:
  retention_days: 7

# 操作审计日志开关
operation_log:
  enabled: true

# 镜像来源：registry 为空时本地构建；填写后从该 registry 拉取
# 例：registry: "ghcr.io/your-org"
image:
  registry: ""
  tag: latest

# 数据持久化目录（宿主路径，相对路径以 deploy/ 为基准）
data:
  volume_dir: "./data"
