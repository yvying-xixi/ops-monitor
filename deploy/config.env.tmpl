# ============================================================
# ops-monitor 平台部署配置（Bash source 文件）
#
# 用法：
#   cp deploy/config.env.tmpl deploy/config.env
#   编辑本文件（至少修改 HOSTNAME）
#   ./deploy/install.sh
#
# 注意：
#   - 本文件由 Bash `source` 执行，仅允许受信任的部署管理员编辑。
#   - 空密码/密钥由 prepare.sh 自动生成并回写本文件。
#   - deploy/.env 为自动生成产物，请勿手动修改。
# ============================================================

# 平台对外访问地址（IP 或域名），用于访问提示与 CORS
HOSTNAME="127.0.0.1"

# 对外 HTTP 端口
HTTP_PORT=80

# HTTPS（默认关闭）。启用时填写证书/私钥路径（相对 deploy/ 或绝对路径）
HTTPS_ENABLED=false
HTTPS_PORT=443
HTTPS_CERTIFICATE=""
HTTPS_PRIVATE_KEY=""

# 业务数据库
DB_NAME="ops_monitor"
DB_PASSWORD=""

# Redis
REDIS_PASSWORD=""

# JWT
JWT_SECRET_KEY=""
JWT_EXPIRE_MINUTES=120

# 初始管理员（仅首次初始化 seed 时生效）
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""

# 运行
SEED_INIT_DATA=true
METRIC_RETENTION_DAYS=7
TASK_RETENTION_DAYS=30
OPERATION_LOG_ENABLED=true

# Prometheus 指标（METRICS_TOKEN 为空时不鉴权，仅内网可达）
METRICS_ENABLED=true
METRICS_TOKEN=""

# Agent 请求签名（Ed25519）。灰度：false 时无签名请求放行；true 时强制签名
AGENT_REQUIRE_SIGNATURE=false
AGENT_SIGNATURE_MAX_SKEW=300

# 备份（deploy/backup.sh）
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=14
BACKUP_INCLUDE_CONFIG=true
BACKUP_INCLUDE_REDIS=false
BACKUP_INCLUDE_NGINX=false
# 备份后钩子（可选，receives $ARCHIVE），例如：rclone sync "$ARCHIVE" remote:ops-monitor
BACKUP_POST_CMD=""

# 镜像来源：IMAGE_REGISTRY 为空时本地构建
IMAGE_REGISTRY=""
IMAGE_TAG="latest"
# 纯拉取部署：true 时加载 deploy/docker/compose.hub.yml（只拉取、不本地构建）
IMAGE_PULL_ONLY=false

# 数据持久化目录（宿主路径，相对 deploy/ 或绝对路径）
DATA_VOLUME_DIR="./data"
