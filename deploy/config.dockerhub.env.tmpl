# ============================================================
# ops-monitor 平台部署配置 —— Docker Hub 预构建镜像（纯拉取）
#
# 用法：
#   cp deploy/config.dockerhub.env.tmpl deploy/config.env
#   1) 把下方 IMAGE_REGISTRY 的 <namespace> 替换为你的 Docker Hub 用户名/组织
#   2) 按需修改 HOSTNAME
#   ./deploy/install.sh
#
# 说明：
#   - 镜像为公开仓库，拉取无需 docker login。
#   - IMAGE_TAG 默认 v0.2.0（可复现）；如需跟随最新可改为 latest。
#   - IMAGE_PULL_ONLY=true 启用 compose.hub.yml（只拉取、不本地构建）。
#   - 部署仍需本仓库检出（compose、deploy/mysql/init、deploy/nginx/conf.d、agent/、deploy/systemd/）。
#   - 本文件由 Bash `source` 执行，仅允许受信任的部署管理员编辑。
#   - 空密码/密钥由 prepare.sh 自动生成并回写本文件。
# ============================================================

# 平台对外访问地址（IP 或域名），用于访问提示与 CORS
HOSTNAME="127.0.0.1"

# 对外 HTTP 端口
HTTP_PORT=80

# HTTPS（默认关闭）。启用时填写证书/私钥路径（相对 deploy/ 或绝对路径）
HTTPS_ENABLED=false
HTTPS_PORT=443
HTTPS_CERTIFICATE=""
HTTPS_PRIVATE_KEY=""

# 业务数据库
DB_NAME="ops_monitor"
DB_PASSWORD=""

# Redis
REDIS_PASSWORD=""

# JWT
JWT_SECRET_KEY=""
JWT_EXPIRE_MINUTES=120

# 初始管理员（仅首次初始化 seed 时生效）
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""

# 运行
SEED_INIT_DATA=true
METRIC_RETENTION_DAYS=7
OPERATION_LOG_ENABLED=true

# 镜像来源：Docker Hub 命名空间（<namespace> 替换为你的用户名/组织）
IMAGE_REGISTRY="docker.io/<namespace>"
IMAGE_TAG="v0.2.0"
# 纯拉取部署（配合 deploy/docker/compose.hub.yml）
IMAGE_PULL_ONLY=true

# 数据持久化目录（宿主路径，相对 deploy/ 或绝对路径）
DATA_VOLUME_DIR="./data"
